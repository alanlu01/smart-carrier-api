APP_ENV=development
ORACLE_USER=ADMIN
ORACLE_PASSWORD=replace-with-database-password
ORACLE_DSN=carrierdb_low
ORACLE_WALLET_DIR=/opt/oracle/wallet
ORACLE_WALLET_PASSWORD=replace-with-wallet-password
ORACLE_POOL_MAX=4
ORACLE_WALLET_HOST_PATH=/home/ubuntu/smart-carrier-secrets/oracle-wallet
ROBOT_API_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=http://127.0.0.1:5173,https://alanlu01.github.io

# Oracle VM reverse proxy. Keep :80 while testing by public IP.
# Change to a DNS name such as api.example.com to enable automatic HTTPS.
API_DOMAIN=:80
